# Data repository base URL (defaults to http://localhost:8000 in dev, ./data in production)
VITE_DATA_BASE_URL=https://mls-oer-question-bank.github.io/mls-oer-data

# Target GitHub repository (owner/name) for OAuth, Issues, Errata, and Giscus discussions
VITE_GITHUB_REPO=mls-oer-question-bank/mls-oer-question-bank

# GitHub OAuth App Client ID & stateless Cloudflare Worker token exchange relay
VITE_GITHUB_CLIENT_ID=
VITE_OAUTH_RELAY_URL=

# Giscus (GitHub Discussions) configuration mapped by immutable question UID
VITE_GISCUS_REPO_ID=
VITE_GISCUS_CATEGORY=Question Discussions
VITE_GISCUS_CATEGORY_ID=

# Comma-separated allowlist of verified GitHub emails or domains permitted to submit community contributions
# Supports full emails (e.g., brrice@augusta.edu) and/or domains (e.g., augusta.edu)
VITE_EDUCATOR_EMAIL_ALLOWLIST=brrice@augusta.edu
